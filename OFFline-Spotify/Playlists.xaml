<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OFFline_Spotify.Playlists"
             x:Name="PlaylistsPage"
             Title="Playlists">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Responsive sizes that scale down proportionally on mobile -->
            <OnPlatform x:Key="TitleFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="28" />
                <On Platform="iOS" Value="32" />
                <On Platform="WinUI" Value="40" />
            </OnPlatform>
            
            <OnPlatform x:Key="PlaylistNameFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="14" />
                <On Platform="iOS" Value="18" />
                <On Platform="WinUI" Value="20" />
            </OnPlatform>
            
            <!-- Frame must be tall enough for image + label -->
            <OnPlatform x:Key="FrameSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="300" />
                <On Platform="iOS" Value="260" />
                <On Platform="WinUI" Value="450" />
            </OnPlatform>
            
            <OnPlatform x:Key="ImageSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="160" />
                <On Platform="iOS" Value="200" />
                <On Platform="WinUI" Value="400" />
            </OnPlatform>
            
            <!-- Margin positions button near the bottom-right of the image -->
            <!-- Top margin = ImageSize - half of button height - a small offset -->
            <OnPlatform x:Key="PlayButtonMargin" x:TypeArguments="Thickness">
                <On Platform="Android" Value="0,115,8,0" />
                <On Platform="iOS" Value="0,148,10,0" />
                <On Platform="WinUI" Value="0,330,15,0" />
            </OnPlatform>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout>
            <Label Text="Your's only music"
                   FontSize="{StaticResource TitleFontSize}"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="{OnPlatform Android='0,10,0,20', iOS='0,10,0,25', WinUI='0,10,0,30'}"/>
            
            <CollectionView ItemsSource="{Binding PlaylistsCollection}"
                            Margin="0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                    Span="{OnPlatform Android=1, iOS=2, WinUI=2}"
                                    HorizontalItemSpacing="{OnPlatform Android=0, iOS=10, WinUI=10}"
                                    VerticalItemSpacing="{OnPlatform Android=15, iOS=10, WinUI=10}"/>
                </CollectionView.ItemsLayout>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="{OnPlatform Android='10,5', iOS='10', WinUI='10'}" 
                                           Spacing="5"
                                           HorizontalOptions="Center">
                            <Frame CornerRadius="20" 
                                   Padding="10" 
                                   HasShadow="True" 
                                   HeightRequest="{StaticResource FrameSize}" 
                                   WidthRequest="{StaticResource FrameSize}" 
                                   BackgroundColor="Transparent" 
                                   BorderColor="#e3e3e3"
                                   IsClippedToBounds="True">
                                <Grid RowDefinitions="*, Auto">
                                    <!-- Hover events (works on Windows only) -->
                                    <Grid.GestureRecognizers>
                                        <PointerGestureRecognizer PointerEntered="OnPlaylistPointerEntered"
                                                                  PointerExited="OnPlaylistPointerExited" />
                                    </Grid.GestureRecognizers>
                                    
                                    <!-- Row 0: Image -->
                                    <Border Grid.Row="0"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="0"
                                            Margin="2">
                                        <Image Source="{Binding ImagePath}" 
                                               Aspect="AspectFill">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PlaylistTappedCommand, Source={x:Reference PlaylistsPage}}"
                                                                       CommandParameter="{Binding .}"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Border>

                                    <!-- Row 1: Playlist Name Label -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Name}" 
                                           FontAttributes="Italic"
                                           FontSize="{StaticResource PlaylistNameFontSize}"
                                           TextColor="White"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Margin="4,4,4,2"
                                           VerticalOptions="End"/>
                                    
                                    <!-- Play Button - overlays bottom-right corner of image -->
                                    <Button x:Name="PlayButton"
                                            Grid.Row="0"
                                            Text="►"
                                            FontSize="{OnPlatform Android=24, iOS=26, WinUI=30}"
                                            Style="{StaticResource GradientButtonStyle}"
                                            CornerRadius="{OnPlatform Android=25, iOS=28, WinUI=30}"
                                            WidthRequest="{OnPlatform Android=50, iOS=56, WinUI=60}"
                                            HeightRequest="{OnPlatform Android=50, iOS=56, WinUI=60}"
                                            HorizontalOptions="End"
                                            VerticalOptions="End"
                                            Margin="0,0,8,8"
                                            Opacity="{OnPlatform Android=0.95, iOS=0.95, WinUI=0}"
                                            Scale="{OnPlatform Android=1, iOS=1, WinUI=0.5}"
                                            Clicked="PlayPlaylist_Clicked"
                                            CommandParameter="{Binding}"
                                            IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}"
                                            InputTransparent="False"/>
                                    
                                    <!-- Delete Button - overlays top-right corner of image -->
                                    <ImageButton x:Name="DeleteButton"
                                                Grid.Row="0"
                                                Source="threedots.png"
                                                BackgroundColor="Red"
                                                CornerRadius="{OnPlatform Android=15, iOS=18, WinUI=20}"
                                                WidthRequest="{OnPlatform Android=35, iOS=38, WinUI=40}"
                                                HeightRequest="{OnPlatform Android=35, iOS=38, WinUI=40}"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="{OnPlatform Android='8', iOS='9', WinUI='10'}"
                                                Opacity="{OnPlatform Android=0.95, iOS=0.95, WinUI=0}"
                                                Scale="{OnPlatform Android=1, iOS=1, WinUI=0.5}"
                                                Clicked="DeletePlaylist_Clicked"
                                                CommandParameter="{Binding}"
                                                IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}"
                                                InputTransparent="False"
                                                Padding="6"/>
                                </Grid>
                            </Frame>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>