<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OFFline_Spotify.MainPage"
             x:DataType="local:MainPage"
             xmlns:local="clr-namespace:OFFline_Spotify"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.NavBarIsVisible="True"
             Shell.TitleColor="#e3e3e3"
             Title="OFF-line Spotify">

    <ScrollView>
        <VerticalStackLayout Spacing="40" Padding="20">
            <Frame WidthRequest="600" HeightRequest="500" BackgroundColor="#2a2a2a">
                <VerticalStackLayout>
                    <Label 
                        Text="Welcome to OFF-line Spotify"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        Margin="0,60,0,40" />

                    <!-- Download Button (when no playlists) -->
                    <Button
                        Text="Download your songs!"
                        Style="{StaticResource GradientButtonStyle}"
                        Clicked="Button_Clicked_1"
                        Margin="7"
                        />

                    <Button
                        Text="Go to playlists"
                        Clicked="Button_Clicked"
                        Style="{StaticResource GradientButtonStyle}" Margin="7"/>
                    <Border Background="Gray" StrokeThickness="2" WidthRequest="450" HeightRequest="140" StrokeShape="RoundRectangle 5">
                        <Label
                            Text="Wanted to get rid of annoying ads from Spotify?&#10;'OFF-line Spotify' is your solution to exactly that!&#10;Here you can download all your songs locally without playlist restrictions &#10;like unavailable songs in your country.&#10;Tap below to view the guide on how to use this app."
                            TextColor="Black" 
                            Padding="10"
                            BackgroundColor="Gray"
                            WidthRequest="400"
                            HorizontalOptions="Center"
        />
                    </Border>
                </VerticalStackLayout>
            </Frame>
            
            
            
            
            <!-- Expandable Guide Section -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Frame BackgroundColor="#1DB954" 
                           Padding="15" 
                           CornerRadius="10"
                           HasShadow="True">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="📖" 
                                   FontSize="24" 
                                   VerticalOptions="Center"/>
                            <Label Text="How to Use This App (Tap to expand)" 
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>
                </toolkit:Expander.Header>
                
                <toolkit:Expander.Content>
                    <Frame BackgroundColor="#2a2a2a" 
                           Padding="15" 
                           CornerRadius="10"
                           Margin="0,5,0,0">
                        <VerticalStackLayout Spacing="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Step 0: To use this app you need brave browser and chromedriver downloaded (chromedriver is downloadable and updatable in download page)" 
                                    TextColor="#1DB954"
                                    FontSize="20"
                                    FontAttributes="Bold"/>


                            </VerticalStackLayout>
                            <!-- Step 1 -->
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Step 1: Go to song downloader" 
                                       TextColor="#1DB954"
                                       FontSize="20"
                                       FontAttributes="Bold"/>
                                <Label Text="Step 2: Obtain spotify authorisation link by clicking on copy link button and pasting it in your browser url"
                                       
                                       />
                                
                                <Image Source="step1.png"
                                       Aspect="AspectFit"
                                       HeightRequest="200"/>
                                
                            </VerticalStackLayout>
                            
                            <!-- Step 2 -->
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Step 3: Get authorisation code" 
                                       TextColor="#1DB954"
                                       FontSize="20"
                                       FontAttributes="Bold"/>
                                <Image Source="step2.png"
                                       Aspect="AspectFit"
                                       HeightRequest="200"/>
                                <Image Source="step3.png"
                                        Aspect="AspectFit"
                                        HeightRequest="200"/>
                               
                            </VerticalStackLayout>
                            
                            <!-- Step 3 -->
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Step 3: Paste your code to aprioprate input field" 
                                       TextColor="#1DB954"
                                       FontSize="20"
                                       FontAttributes="Bold"/>
                                
                                
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Step 4: Copy and paste public playlist link to aprioprate input field" 
                                    TextColor="#1DB954"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                       />


                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Step 5: Click on download button and wait until everything is downloaded and setup" 
                                    TextColor="#1DB954"
                                    FontSize="20"
                                    FontAttributes="Bold"/>


                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Step 6: Enjoy!" 
                                    TextColor="#1DB954"
                                    FontSize="20"
                                    FontAttributes="Bold"/>


                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </toolkit:Expander.Content>
            </toolkit:Expander>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
