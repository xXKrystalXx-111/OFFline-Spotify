<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OFFline_Spotify.MainPage"
             x:DataType="local:MainPage"
             xmlns:local="clr-namespace:OFFline_Spotify"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.NavBarIsVisible="True"
             Shell.TitleColor="#e3e3e3"
             Title="OFF-line Spotify">

    <ContentPage.Resources>
        <ResourceDictionary>
            <OnPlatform x:Key="TitleFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="24" />
                <On Platform="iOS" Value="28" />
                <On Platform="WinUI" Value="36" />
            </OnPlatform>

            <OnPlatform x:Key="HeaderFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="16" />
                <On Platform="iOS" Value="18" />
                <On Platform="WinUI" Value="20" />
            </OnPlatform>

            <OnPlatform x:Key="BodyFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="12" />
                <On Platform="iOS" Value="14" />
                <On Platform="WinUI" Value="16" />
            </OnPlatform>

            <OnPlatform x:Key="IconFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="20" />
                <On Platform="iOS" Value="22" />
                <On Platform="WinUI" Value="24" />
            </OnPlatform>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        

        <Image Source="background.png"
        Aspect="AspectFill"
        Opacity="0.35">

            <Image.IsVisible>
                <OnPlatform x:TypeArguments="x:Boolean">
                    <On Platform="Android" Value="False" />
                    <On Platform="WinUI" Value="True" />
                </OnPlatform>
            </Image.IsVisible>

        </Image>
        
            


        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="16">
                <!-- Main Content Frame - Responsive -->
                <Frame BackgroundColor="#2a2a2a"
                       Padding="16"
                       CornerRadius="10"
                       HasShadow="True"
                       MaximumWidthRequest="800"
                       HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="20">
                        <!-- Title -->
                        <Label 
                            Text="Welcome to OFF-line Spotify"
                            FontSize="{StaticResource TitleFontSize}"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Margin="0,20,0,20" />

                        <!-- Buttons -->
                        <Button
                            Text="Download your songs!"
                            Style="{StaticResource GradientButtonStyle}"
                            Clicked="Button_Clicked_1"
                            Margin="0,5"
                            HeightRequest="50" />

                        <Button
                            Text="Go to playlists"
                            Clicked="Button_Clicked"
                            Style="{StaticResource GradientButtonStyle}" 
                            Margin="0,5"
                            HeightRequest="50" />
                        
                        <!-- Info Box - Responsive -->
                        <Border Background="Gray" 
                                StrokeThickness="2" 
                                Stroke="DarkGray"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,10,0,0">
                            <Label
                                TextColor="Black" 
                                FontSize="{StaticResource BodyFontSize}"
                                LineBreakMode="WordWrap"
                                HorizontalTextAlignment="Start">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Wanted to:" FontAttributes="Bold" />
                                        <Span Text="&#x0a;- Get rid of annoying ads from Spotify for free?" FontAttributes="Bold" />
                                        <Span Text="&#x0a;- Actually have control over what is your's?" FontAttributes="Bold" />
                                        <Span Text="&#x0a;- Or listen to music that isn't allowed in your country/region?" FontAttributes="Bold" />
                                        <Span Text="&#x0a;'OFF-line Spotify' is your solution to exactly that!" FontAttributes="Bold"/>
                                        <Span Text="&#x0a;" FontAttributes="Bold"/>
                                        <Span Text="&#x0a;Here you can trully relax from stupid limitations Spotify enforces on its users" FontAttributes="Italic"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Border>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
