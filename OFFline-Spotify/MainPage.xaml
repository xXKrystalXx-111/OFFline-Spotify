<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OFFline_Spotify.MainPage"
             x:DataType="local:MainPage"
             xmlns:local="clr-namespace:OFFline_Spotify"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.NavBarIsVisible="True"
             Shell.TitleColor="#e3e3e3"
             Title="OFF-line Spotify">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Responsive font sizes -->
            <OnPlatform x:Key="TitleFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="24" />
                <On Platform="iOS" Value="28" />
                <On Platform="WinUI" Value="36" />
            </OnPlatform>
            
            <OnPlatform x:Key="HeaderFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="16" />
                <On Platform="iOS" Value="18" />
                <On Platform="WinUI" Value="20" />
            </OnPlatform>
            
            <OnPlatform x:Key="BodyFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="12" />
                <On Platform="iOS" Value="14" />
                <On Platform="WinUI" Value="16" />
            </OnPlatform>
            
            <OnPlatform x:Key="IconFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="20" />
                <On Platform="iOS" Value="22" />
                <On Platform="WinUI" Value="24" />
            </OnPlatform>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="16">
            <!-- Main Content Frame - Responsive -->
            <Frame BackgroundColor="#2a2a2a"
                   Padding="16"
                   CornerRadius="10"
                   HasShadow="True"
                   MaximumWidthRequest="800"
                   HorizontalOptions="Center">
                <VerticalStackLayout Spacing="20">
                    <!-- Title -->
                    <Label 
                        Text="Welcome to OFF-line Spotify"
                        FontSize="{StaticResource TitleFontSize}"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Margin="0,20,0,20" />

                    <!-- Buttons -->
                    <Button
                        Text="Download your songs!"
                        Style="{StaticResource GradientButtonStyle}"
                        Clicked="Button_Clicked_1"
                        Margin="0,5"
                        HeightRequest="50" />

                    <Button
                        Text="Go to playlists"
                        Clicked="Button_Clicked"
                        Style="{StaticResource GradientButtonStyle}" 
                        Margin="0,5"
                        HeightRequest="50" />
                    
                    <!-- Info Box - Responsive -->
                    <Border Background="Gray" 
                            StrokeThickness="2" 
                            Stroke="DarkGray"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            Margin="0,10,0,0">
                        <Label
                            TextColor="Black" 
                            FontSize="{StaticResource BodyFontSize}"
                            LineBreakMode="WordWrap"
                            HorizontalTextAlignment="Start">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Wanted to get rid of annoying ads from Spotify?" FontAttributes="Bold" />
                                    <Span Text="&#x0a;'OFF-line Spotify' is your solution to exactly that!" />
                                    <Span Text="&#x0a;&#x0a;Here you can download all your songs locally without playlist restrictions like unavailable songs in your country." />
                                    <Span Text="&#x0a;&#x0a;Tap below to view the guide on how to use this app." FontAttributes="Italic" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </VerticalStackLayout>
            </Frame>
            
            <!-- Expandable Guide Section -->
            <toolkit:Expander MaximumWidthRequest="800"
                             HorizontalOptions="Center">
                <toolkit:Expander.Header>
                    <Frame BackgroundColor="#1DB954" 
                           Padding="15" 
                           CornerRadius="10"
                           HasShadow="True">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="📖" 
                                   FontSize="{StaticResource IconFontSize}" 
                                   VerticalOptions="Center"/>
                            <Label Text="How to Use This App (Tap to expand)" 
                                   TextColor="White"
                                   FontSize="{StaticResource HeaderFontSize}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"
                                   FlexLayout.Grow="1"/>
                        </HorizontalStackLayout>
                    </Frame>
                </toolkit:Expander.Header>
                
                <toolkit:Expander.Content>
                    <Frame BackgroundColor="#2a2a2a" 
                           Padding="15" 
                           CornerRadius="10"
                           Margin="0,5,0,0">
                        <VerticalStackLayout Spacing="20">
                            <!-- Step 0 -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Step 0: Requirements" 
                                    TextColor="#1DB954"
                                    FontSize="{StaticResource HeaderFontSize}"
                                    FontAttributes="Bold"/>
                                <Label Text="To use this app you need brave browser and chromedriver downloaded (chromedriver is downloadable and updatable in download page)"
                                       FontSize="{StaticResource BodyFontSize}"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            
                            <!-- Step 1 -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Step 1: Go to song downloader" 
                                       TextColor="#1DB954"
                                       FontSize="{StaticResource HeaderFontSize}"
                                       FontAttributes="Bold"/>
                                <Label Text="Obtain spotify authorisation link by clicking on copy link button and pasting it in your browser url"
                                       FontSize="{StaticResource BodyFontSize}"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" />
                                
                                <Image Source="step1.png"
                                       Aspect="AspectFit"
                                       MaximumHeightRequest="200"
                                       Margin="0,10,0,0"/>
                            </VerticalStackLayout>
                            
                            <!-- Step 2 -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Step 2: Get authorisation code" 
                                       TextColor="#1DB954"
                                       FontSize="{StaticResource HeaderFontSize}"
                                       FontAttributes="Bold"/>
                                <Image Source="step2.png"
                                       Aspect="AspectFit"
                                       MaximumHeightRequest="200"
                                       Margin="0,10,0,0"/>
                                <Image Source="step3.png"
                                        Aspect="AspectFit"
                                        MaximumHeightRequest="200"
                                        Margin="0,10,0,0"/>
                            </VerticalStackLayout>
                            
                            <!-- Step 3 -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Step 3: Paste your code" 
                                       TextColor="#1DB954"
                                       FontSize="{StaticResource HeaderFontSize}"
                                       FontAttributes="Bold"/>
                                <Label Text="Paste your code to appropriate input field"
                                       FontSize="{StaticResource BodyFontSize}"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            
                            <!-- Step 4 -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Step 4: Add playlist link" 
                                    TextColor="#1DB954"
                                    FontSize="{StaticResource HeaderFontSize}"
                                    FontAttributes="Bold" />
                                <Label Text="Copy and paste public playlist link to appropriate input field"
                                       FontSize="{StaticResource BodyFontSize}"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            
                            <!-- Step 5 -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Step 5: Download" 
                                    TextColor="#1DB954"
                                    FontSize="{StaticResource HeaderFontSize}"
                                    FontAttributes="Bold"/>
                                <Label Text="Click on download button and wait until everything is downloaded and setup"
                                       FontSize="{StaticResource BodyFontSize}"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            
                            <!-- Step 6 -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Step 6: Enjoy! 🎵" 
                                    TextColor="#1DB954"
                                    FontSize="{StaticResource HeaderFontSize}"
                                    FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </toolkit:Expander.Content>
            </toolkit:Expander>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
