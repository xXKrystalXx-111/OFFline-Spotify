<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OFFline_Spotify"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="OFFline_Spotify.PlaylistDetails">
    
    <ContentPage.ToolbarItems>
        <ToolbarItem 
                     IconImageSource="threedots.png"
                     Order="Primary" 
                     Priority="0"
                     Clicked="DeletePlaylist_Clicked" />
    </ContentPage.ToolbarItems>
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Reference the converter with the correct namespace -->
            <local:Mp3FileExistsConverter x:Key="Mp3FileExistsConverter"/>
            <local:SongBackgroundConverter x:Key="SongBackgroundConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="*,Auto" Padding="8">
        <!-- Song List -->
        <ListView x:Name="SongsListView" 
                  ItemTapped="SongsListView_ItemTapped"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" 
                              RowDefinitions="Auto,Auto" 
                              ColumnDefinitions="*,Auto,Auto"
                              BackgroundColor="{Binding IsCurrentlyPlaying, Converter={StaticResource SongBackgroundConverter}}">
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="{Binding Title}" 
                                       TextColor="{Binding Mp3FilePath, Converter={StaticResource Mp3FileExistsConverter}}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="{Binding Artist}" FontSize="14" TextColor="Gray" />
                            </StackLayout>
                            
                            <!-- Warning icon for missing files -->
                            <Label Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding Mp3FilePath, Converter={StaticResource Mp3FileExistsConverter}, ConverterParameter='icon'}"
                                   VerticalOptions="Center"
                                   FontSize="22"
                                   IsVisible="{Binding Mp3FilePath, Converter={StaticResource Mp3FileExistsConverter}, ConverterParameter='bool-inverted'}"
                                   Margin="5,0"/>
                            
                            <!-- Clickable ImageButton for editing -->
                            <ImageButton Grid.Row="0" Grid.Column="2"
                                        Source="threedots.png"
                                        BackgroundColor="Transparent"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"
                                        Clicked="EditSong_Clicked"
                                        CommandParameter="{Binding}"
                                        Aspect="AspectFit"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Player Controls -->
        <Frame Grid.Row="1" 
               BackgroundColor="#2a2a2a"
               BorderColor="#4a4a4a"
               CornerRadius="10"
               Padding="15"
               Margin="8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*">
                <!-- Now Playing Info -->
                <Label x:Name="NowPlayingLabel" 
                       Grid.Row="0"
                       Text="No song playing" 
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="White"
                       Margin="0,0,0,8"/>
                
                <!-- Progress Bar with Time Labels -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                    <Label x:Name="CurrentTimeLabel" 
                           Grid.Column="0" 
                           Text="0:00" 
                           VerticalOptions="Center"
                           TextColor="White"/>
                    
                    <Slider x:Name="ProgressSlider" 
                            Grid.Column="1"
                            Minimum="0" 
                            Maximum="100"
                            ValueChanged="ProgressSlider_ValueChanged"
                            DragStarted="ProgressSlider_DragStarted"
                            DragCompleted="ProgressSlider_DragCompleted"/>
                    
                    <Label x:Name="TotalTimeLabel" 
                           Grid.Column="2" 
                           Text="0:00" 
                           VerticalOptions="Center"
                           TextColor="White"/>
                </Grid>

                <!-- Playback Controls and Volume -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="0,0,0,0">
                    <!-- Empty space for balance (Bottom Left) -->
                    <BoxView Grid.Column="0" 
                             IsVisible="False"/>
                    
                    <!-- Playback Controls (Center) -->
                    <HorizontalStackLayout Grid.Column="1" 
                                          HorizontalOptions="Center" 
                                          Spacing="16" 
                                          VerticalOptions="Center">
                        <Button x:Name="PreviousButton" 
                                Style="{StaticResource GradientButtonStyle}"
                                Text="˂" 
                                FontSize="24"
                                Clicked="Previous_Clicked"
                                WidthRequest="60"
                                HeightRequest="50"/>
                        
                        <Button x:Name="PlayPauseButton" 
                                Style="{StaticResource GradientButtonStyle}"
                                Text="►" 
                                FontSize="24"
                                Clicked="PlayPause_Clicked"
                                WidthRequest="60"
                                HeightRequest="50"/>
                        
                        <Button x:Name="NextButton" 
                                Style="{StaticResource GradientButtonStyle}"
                                Text="˃" 
                                FontSize="24"
                                Clicked="Next_Clicked"
                                WidthRequest="60"
                                HeightRequest="50"/>
                    </HorizontalStackLayout>
                    
                    <!-- Volume Control (Bottom Right) -->
                    <HorizontalStackLayout Grid.Column="2" 
                                          HorizontalOptions="End" 
                                          Spacing="8" 
                                          VerticalOptions="Center">
                        <Border StrokeThickness="2"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 5"
                                BackgroundColor="LightGrey"
                                Padding="3"
                                VerticalOptions="Center">
                            <Image Source="volume.png"
                                   HeightRequest="15"
                                   WidthRequest="15"
                                   VerticalOptions="Center"
                                   BackgroundColor="LightGrey"
                                   Aspect="AspectFit"/>
                        </Border>
                        
                        <Slider x:Name="VolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                WidthRequest="120"
                                ValueChanged="VolumeSlider_ValueChanged"
                                VerticalOptions="Center"/>
                        
                        <Label x:Name="VolumeLabel"
                               Text="100%"
                               FontSize="12"
                               VerticalOptions="Center"
                               TextColor="White"
                               WidthRequest="40"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Hidden MediaElement (no built-in controls) -->
                <toolkit:MediaElement x:Name="Player"
                                      Grid.Row="3"
                                      HeightRequest="0"
                                      IsVisible="False"
                                      ShouldShowPlaybackControls="False"
                                      ShouldAutoPlay="False"
                                      Volume="1"
                                      StateChanged="Player_StateChanged"
                                      PositionChanged="Player_PositionChanged"
                                      MediaEnded="Player_MediaEnded"
                                      BackgroundColor="#181818"/>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>