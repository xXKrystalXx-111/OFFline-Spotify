<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OFFline_Spotify.Playlists"
             x:Name="PlaylistsPage"
             Title="Playlists">
    <ScrollView>
        <VerticalStackLayout>
            <Label Text="Your's only music"
                   FontSize="40"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="0,10,0,30"/>
            <CollectionView ItemsSource="{Binding PlaylistsCollection}"
                            ItemsLayout="VerticalGrid, 2"
                            Margin="0,0,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10" Spacing="5">
                            <Frame CornerRadius="20" Padding="10" HasShadow="True" HeightRequest="450" WidthRequest="450" BackgroundColor="Transparent" BorderColor="#e3e3e3">
                                <Grid>
                                    <!-- Add hover events to Grid instead of Image -->
                                    <Grid.GestureRecognizers>
                                        <PointerGestureRecognizer PointerEntered="OnPlaylistPointerEntered"
                                                                  PointerExited="OnPlaylistPointerExited" />
                                    </Grid.GestureRecognizers>
                                    
                                    <VerticalStackLayout>
                                        <Border StrokeShape="RoundRectangle 20"
                                               StrokeThickness="0"
                                               WidthRequest="400" 
                                               HeightRequest="400"
                                               Margin="2">
                                            <Image Source="{Binding ImagePath}" 
                                                   Aspect="AspectFill">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding BindingContext.PlaylistTappedCommand, Source={x:Reference PlaylistsPage}}"
                                                                           CommandParameter="{Binding .}"/>
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Border>
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Italic"
                                               FontSize="20"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="End"/>
                                    </VerticalStackLayout>
                                    
                                    <!-- Animated Play Button (Bottom Right on Image) -->
                                    <Button x:Name="PlayButton"
                                            Text="►"
                                            FontSize="30"
                                            
                                            Style="{StaticResource GradientButtonStyle}"
                                            CornerRadius="30"
                                            WidthRequest="60"
                                            HeightRequest="60"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="0,330,15,0"
                                            Opacity="0"
                                            Scale="0.5"
                                            Clicked="PlayPlaylist_Clicked"
                                            CommandParameter="{Binding}"
                                            IsVisible="False"
                                            InputTransparent="False"/>
                                    
                                    <!-- Animated Delete Button (Top Right) -->
                                    <ImageButton x:Name="DeleteButton"
                                                Source="threedots.png"
                                                BackgroundColor="Red"
                                                CornerRadius="20"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="10"
                                                Opacity="0"
                                                Scale="0.5"
                                                Clicked="DeletePlaylist_Clicked"
                                                CommandParameter="{Binding}"
                                                IsVisible="False"
                                                InputTransparent="False"/>
                                </Grid>
                            </Frame>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>