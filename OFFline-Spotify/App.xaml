<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OFFline_Spotify"
             x:Class="OFFline_Spotify.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary>
                    <!-- Default ContentPage Style -->
                    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                        <Setter Property="BackgroundColor" Value="#1a1a1a"/>
                        <Setter Property="Padding" Value="16"/>
                        
                        
                    </Style>
                    
                    <!-- Button Style -->
                    <Style x:Key="GradientButtonStyle" TargetType="Button">
                        <Setter Property="CornerRadius" Value="25"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="TextColor" Value="Black"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6e6e6e" Offset="0.0"/>
                                    <GradientStop Color="White" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
