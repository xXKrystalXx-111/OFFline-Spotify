<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OFFline_Spotify.Playlists"
             x:Name="PlaylistsPage"
             Title="Playlists">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Responsive font sizes -->
            <OnPlatform x:Key="TitleFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="28" />
                <On Platform="iOS" Value="32" />
                <On Platform="WinUI" Value="40" />
            </OnPlatform>
            
            <OnPlatform x:Key="PlaylistNameFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="16" />
                <On Platform="iOS" Value="18" />
                <On Platform="WinUI" Value="20" />
            </OnPlatform>
            
            <!-- Responsive grid span -->
            <OnPlatform x:Key="GridSpan" x:TypeArguments="x:Int32">
                <On Platform="Android" Value="1" />
                <On Platform="iOS" Value="2" />
                <On Platform="WinUI" Value="2" />
            </OnPlatform>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="16">
            <Label Text="Your's only music"
                   FontSize="{StaticResource TitleFontSize}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="0,10,0,20"
                   LineBreakMode="WordWrap"/>
            
            <CollectionView ItemsSource="{Binding PlaylistsCollection}"
                            Margin="0"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                    Span="{OnPlatform Android=1, iOS=2, WinUI=2}"
                                    HorizontalItemSpacing="12"
                                    VerticalItemSpacing="12"/>
                </CollectionView.ItemsLayout>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="12" 
                               Padding="8" 
                               HasShadow="True" 
                               BackgroundColor="Transparent" 
                               BorderColor="#e3e3e3"
                               Margin="4">
                            <Grid>
                                <!-- Add hover events to Grid -->
                                <Grid.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEntered="OnPlaylistPointerEntered"
                                                              PointerExited="OnPlaylistPointerExited" />
                                </Grid.GestureRecognizers>
                                
                                <VerticalStackLayout Spacing="8">
                                    <!-- Playlist Image -->
                                    <Border StrokeShape="RoundRectangle 12"
                                           StrokeThickness="0"
                                           HeightRequest="{OnPlatform Android=180, iOS=200, WinUI=400}"
                                           Margin="0">
                                        <Image Source="{Binding ImagePath}" 
                                               Aspect="AspectFill">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PlaylistTappedCommand, Source={x:Reference PlaylistsPage}}"
                                                                       CommandParameter="{Binding .}"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Border>
                                    
                                    <!-- Playlist Name -->
                                    <Label Text="{Binding Name}" 
                                           FontAttributes="Bold"
                                           FontSize="{StaticResource PlaylistNameFontSize}"
                                           TextColor="White"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Margin="4,0"/>
                                </VerticalStackLayout>
                                
                                <!-- Play Button (On image, mobile-friendly) -->
                                <Button x:Name="PlayButton"
                                        Text="►"
                                        FontSize="{OnPlatform Android=24, iOS=26, WinUI=30}"
                                        Style="{StaticResource GradientButtonStyle}"
                                        CornerRadius="{OnPlatform Android=25, iOS=28, WinUI=30}"
                                        WidthRequest="{OnPlatform Android=50, iOS=56, WinUI=60}"
                                        HeightRequest="{OnPlatform Android=50, iOS=56, WinUI=60}"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="{OnPlatform Android='0,130,10,0', iOS='0,150,12,0', WinUI='0,330,15,0'}"
                                        Opacity="{OnPlatform Android=0.9, Default=0}"
                                        Scale="{OnPlatform Android=1, Default=0.5}"
                                        Clicked="PlayPlaylist_Clicked"
                                        CommandParameter="{Binding}"
                                        IsVisible="{OnPlatform Android=True, Default=False}"
                                        InputTransparent="False"/>
                                
                                <!-- Delete Button (Top Right, always visible on mobile) -->
                                <ImageButton x:Name="DeleteButton"
                                            Source="threedots.png"
                                            BackgroundColor="Red"
                                            CornerRadius="{OnPlatform Android=15, iOS=18, WinUI=20}"
                                            WidthRequest="{OnPlatform Android=35, iOS=38, WinUI=40}"
                                            HeightRequest="{OnPlatform Android=35, iOS=38, WinUI=40}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="8"
                                            Opacity="{OnPlatform Android=0.9, Default=0}"
                                            Scale="{OnPlatform Android=1, Default=0.5}"
                                            Clicked="DeletePlaylist_Clicked"
                                            CommandParameter="{Binding}"
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            InputTransparent="False"
                                            Padding="6"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>