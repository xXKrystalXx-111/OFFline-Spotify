<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OFFline_Spotify.ReplaceMp3Page"
             Title="Replace MP3 File"
             Shell.ForegroundColor="#e3e3e3"
             Shell.BackgroundColor="#2a2a2a"
             Shell.TitleColor="#e3e3e3"
             Shell.TabBarBackgroundColor="#2a2a2a"
             Shell.TabBarForegroundColor="#e3e3e3">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Responsive font sizes -->
            <OnPlatform x:Key="HeaderFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="16" />
                <On Platform="iOS" Value="18" />
                <On Platform="WinUI" Value="18" />
            </OnPlatform>
            
            <OnPlatform x:Key="TitleFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="14" />
                <On Platform="iOS" Value="16" />
                <On Platform="WinUI" Value="16" />
            </OnPlatform>
            
            <OnPlatform x:Key="BodyFontSize" x:TypeArguments="x:Double">
                <On Platform="Android" Value="12" />
                <On Platform="iOS" Value="14" />
                <On Platform="WinUI" Value="14" />
            </OnPlatform>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16" 
                            Padding="16"
                            MaximumWidthRequest="600">

            <!-- Song Information -->
            <Frame BackgroundColor="#2a2a2a" 
                   BorderColor="#3a3a3a"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Song Information" 
                           FontAttributes="Bold" 
                           FontSize="{StaticResource HeaderFontSize}" 
                           TextColor="#1DB954"/>

                    <Label x:Name="SongTitleLabel" 
                           Text="Song Title" 
                           FontAttributes="Bold" 
                           FontSize="{StaticResource TitleFontSize}" 
                           TextColor="#e3e3e3"
                           LineBreakMode="WordWrap"/>

                    <Label x:Name="SongArtistLabel" 
                           Text="Artist" 
                           FontSize="{StaticResource BodyFontSize}" 
                           TextColor="#b3b3b3"
                           LineBreakMode="WordWrap"/>

                    <BoxView Color="#3a3a3a" 
                            HeightRequest="1" 
                            Margin="0,8"/>

                    <Label x:Name="CurrentFileLabel" 
                           Text="Current file: No file assigned" 
                           FontSize="{StaticResource BodyFontSize}" 
                           TextColor="#888888"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <!-- File Selection -->
            <Frame BackgroundColor="#2a2a2a" 
                   BorderColor="#3a3a3a"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Select New MP3 File" 
                           FontAttributes="Bold" 
                           FontSize="{StaticResource HeaderFontSize}" 
                           TextColor="#1DB954"/>

                    <Button x:Name="BrowseFileButton"
                            Text="📂 Browse for MP3 File"
                            Style="{StaticResource GradientButtonStyle}"
                            Clicked="BrowseFile_Clicked"
                            HeightRequest="50"
                            FontSize="{StaticResource TitleFontSize}"
                            HorizontalOptions="Fill"/>

                    <Frame BackgroundColor="#1a1a1a"
                           BorderColor="#3a3a3a"
                           CornerRadius="8"
                           Padding="12"
                           IsVisible="{Binding Source={x:Reference SelectedFileLabel}, Path=IsVisible}">
                        <Label x:Name="SelectedFileLabel" 
                               Text="No file selected" 
                               FontSize="{StaticResource BodyFontSize}" 
                               TextColor="#1DB954"
                               LineBreakMode="WordWrap"
                               IsVisible="False"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <VerticalStackLayout Spacing="12">
                <Button x:Name="ReplaceButton"
                        Text="✓ Replace MP3 File"
                        Style="{StaticResource GradientButtonStyle}"
                        Clicked="Replace_Clicked"
                        IsEnabled="False"
                        HeightRequest="50"
                        FontSize="{StaticResource TitleFontSize}"
                        HorizontalOptions="Fill"/>

                <Button x:Name="RemoveButton"
                        Text="🗑 Remove Current File"
                        BackgroundColor="#d32f2f"
                        TextColor="White"
                        Clicked="Remove_Clicked"
                        HeightRequest="50"
                        FontSize="{StaticResource TitleFontSize}"
                        CornerRadius="8"
                        HorizontalOptions="Fill"/>

                <Button x:Name="CancelButton"
                        Text="✕ Cancel"
                        BackgroundColor="Transparent"
                        BorderColor="#666666"
                        BorderWidth="2"
                        TextColor="#e3e3e3"
                        Clicked="Cancel_Clicked"
                        HeightRequest="50"
                        FontSize="{StaticResource TitleFontSize}"
                        CornerRadius="8"
                        HorizontalOptions="Fill"/>
            </VerticalStackLayout>

            <!-- Status Label -->
            <Frame BackgroundColor="#2a2a2a"
                   BorderColor="#3a3a3a"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True"
                   IsVisible="{Binding Source={x:Reference StatusLabel}, Path=IsVisible}">
                <Label x:Name="StatusLabel" 
                       Text="" 
                       FontSize="{StaticResource TitleFontSize}" 
                       FontAttributes="Bold"
                       TextColor="#4caf50"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       IsVisible="False"/>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>